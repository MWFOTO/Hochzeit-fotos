# Example only. Never commit real secrets. Node 22.13+.
PORT=3000
BASE_URL=http://localhost:3000
DB_PATH=./events.db
UPLOAD_DIR=./uploads
# Missing Stripe keys disables checkout, not login/dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Pilot-event cap only; the standard package has no photo-count cap.
MAX_EVENT_PHOTOS=2000
MAX_EVENT_BYTES=26843545600
# Enable only behind exactly one trusted proxy (Render).
TRUST_PROXY=0

# Optional private Hetzner Object Storage for event photos.
# Use fsn1 (Falkenstein) or nbg1 (Nuremberg) to keep photo objects in Germany.
# Never make the bucket public; set these only as hosting-service secrets.
# Leave all S3 values empty to keep local-disk storage.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Required for production S3 storage: base64-encoded random 32-byte key.
# Store a recovery copy securely; losing it makes encrypted photos unreadable.
S3_SSE_C_KEY=
# The application stops accepting uploads at this total photo-storage limit.
# Default is 900 GiB to leave headroom below the included 1 TB allowance.
S3_MAX_STORAGE_BYTES=966367641600

# Optional transactional mail delivery (store secrets only in hosting environment)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=info@matthiaswendlandfotografie.com
BREVO_SENDER_NAME=Event-Fotos · Matthias Wendland
